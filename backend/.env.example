# --- HTTP API (served behind https://api.smartpower.tn) ---
PORT=4000
PUBLIC_API_URL=https://api.smartpower.tn
CORS_ORIGINS=https://smartpower.tn,https://app.smartpower.tn

# --- Database ---
DATABASE_URL=mysql://smartpower:smartpower@localhost:3306/smartpower

# --- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- MQTT broker (devices connect to mqtt.smartpower.tn) ---
MQTT_PORT=1883
MQTT_WS_PORT=8083
PUBLIC_MQTT_HOST=mqtt.smartpower.tn
PUBLIC_MQTT_PORT=8883

# Seconds between stored raw energy samples per device
ENERGY_SAMPLE_INTERVAL=60
